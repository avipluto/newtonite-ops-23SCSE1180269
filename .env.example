# Optional: copy to .env to override the defaults used by docker-compose.yml.
# Nothing here is required for a local demo; never commit a real .env.
POSTGRES_USER=ops
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ops
# Host ports (change if they clash with something already running)
DB_PORT=5434
APP_PORT=8000
# How long a login token stays valid
TOKEN_TTL_HOURS=12
